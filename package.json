{
  "name": "paynym-bot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Always-online BIP47 receiver that accepts payments without a notification transaction, using Soroban as the payment-code transport.",
  "license": "GPL-3.0-only",
  "scripts": {
    "vectors": "node --experimental-strip-types --no-warnings test/vectors.test.ts",
    "protocol": "node --experimental-strip-types --no-warnings test/protocol.test.ts",
    "regress": "node --experimental-strip-types --no-warnings test/register-fixes.test.ts",
    "test": "npm run vectors && npm run protocol && npm run regress && npm run state && npm run seed && npm run torrc && npm run samourai && npm run config && npm run install-checks && npm run server && npm run auth47 && npm run electrum && npm run socks && npm run discover && npm run daemon",
    "state": "node --experimental-strip-types --no-warnings test/state.test.ts",
    "server": "node --experimental-strip-types --no-warnings test/server.test.ts",
    "electrum": "node --experimental-strip-types --no-warnings test/electrum.test.ts",
    "daemon": "node --experimental-strip-types --no-warnings test/daemon.test.ts",
    "seed": "node --experimental-strip-types --no-warnings test/seed.test.ts",
    "typecheck": "tsc --noEmit --strict --module nodenext --target es2022 --allowImportingTsExtensions src/*.ts test/*.ts bin/*.ts scripts/*.ts example.ts",
    "discover": "node --experimental-strip-types --no-warnings test/discover.test.ts",
    "torrc": "node --experimental-strip-types --no-warnings test/torrc.test.ts",
    "samourai": "node --experimental-strip-types --no-warnings test/samourai.test.ts",
    "socks": "node --experimental-strip-types --no-warnings test/socks.test.ts",
    "config": "node --experimental-strip-types --no-warnings test/config.test.ts",
    "install-checks": "node --experimental-strip-types --no-warnings test/install.test.ts",
    "auth47": "node --experimental-strip-types --no-warnings test/auth47.test.ts"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^2.0.0",
    "@dojo-tools/auth47": "^2.0.0",
    "@dojo-tools/bip47": "^2.0.0",
    "@dojo-tools/bitcoinjs-message": "^4.0.0",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.0",
    "@scure/base": "^1.2.0",
    "@scure/bip32": "^1.6.0",
    "@scure/bip39": "^2.4.0",
    "tweetnacl": "^1.0.3"
  },
  "bin": {
    "paynym-bot": "bin/paynym-bot.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "5.9"
  }
}
